// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git": {
    "diff_base": "head"
  },
  "markdown_preview_code_font_family": "JetBrainsMonoNL Nerd Font",
  "markdown_preview_font_family": "Adwaita Sans",
  "terminal": {
    "font_family": "JetBrainsMonoNL Nerd Font Mono"
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "effort": "max",
        "model": "opencode/deepseek-v4-flash-free"
      },
      "favorite_config_option_values": {
        "model": [
          "opencode/deepseek-v4-flash-free",
          "opencode/mimo-v2.5-free",
          "opencode/big-pickle",
          "opencode/nemotron-3-super-free",
          "opencode/nemotron-3-ultra-free"
        ]
      },
      "type": "registry",
    },
    "github-copilot-cli": {
      "default_config_options": {
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent",
        "allow_all": "on",
        "reasoning_effort": "xhigh"
      },
      "type": "registry",
    },
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "zed",
    "mode": "subtle",
  },
  "agent": {
    "notify_when_agent_waiting": "all_screens",
    "sidebar_side": "right",
    "thinking_display": "preview",
    "sandbox_permissions": {
      "write_paths": [
        {
          "requested": "/home/um/dev/flutter/bin/cache",
          "resolved": "/home/um/dev/flutter/bin/cache"
        }
      ],
      "network_hosts": [
        "doc.rust-lang.org",
        "cppreference.com",
        "raw.githubusercontent.com"
      ]
    },
    "tool_permissions": {
      "tools": {
        "move_path": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow"
        },
        "write_file": {
          "default": "allow"
        },
        "edit_file": {
          "default": "allow"
        },
        "search_web": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        },
        "skill": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
        },
      },
    },
    "dock": "right",
    "default_model": {
      "effort": "max",
      "provider": "opencode",
      "model": "zen/deepseek-v4-flash",
      "enable_thinking": true,
    },
    "show_turn_stats": true,
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "claude-sonnet-4-6",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "zed.dev",
        "model": "gpt-5.5",
        "enable_thinking": true,
        "effort": "xhigh"
      },
      {
        "provider": "zed.dev",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "OpenCode Custom",
        "model": "opencode/deepseek-v4-flash-free",
        "enable_thinking": true,
        "effort": "max"
      }
    ],
    "model_parameters": [],
    "enable_feedback": false,
  },
  "auto_signature_help": true,
  "lsp": {
    "clangd": {
      "enable_lsp_tasks": true,
      "binary": {
        "arguments": ["--background-index", "--clang-tidy"],
      },
    },
    "ruff": {
      "enable_lsp_tasks": true,
      "initialization_options": {
        "settings": {
          "lineLength": 120,
          "organizeImports": true,
          "lint": { "enabled": true },
        },
      },
    },
  },
  "languages": {
    "Python": {
      "enable_language_server": true,
      "language_servers": ["ruff", "ty"],
      "formatter": "language_server",
    },
    "C++": {
      "language_servers": ["clangd"],
      "formatter": "language_server",
      "format_on_save": "on",
    },
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "colorize_brackets": true,
  "inlay_hints": {
    "show_background": false,
    "enabled": false,
  },
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "always",
  },
  "minimap": {
    "show": "always",
  },
  "relative_line_numbers": "enabled",
  "which_key": {
    "enabled": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 100,
    },
  },
  "text_rendering_mode": "subpixel",
  "ui_font_family": "Adwaita Sans",
  "ui_font_weight": 500.0,
  "buffer_font_family": "JetBrainsMonoNL Nerd Font",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 20.0,
  "buffer_font_size": 20.0,
  "theme": {
    "mode": "dark",
    "light": "macOS Classic Light",
    "dark": "JetBrains Islands Dark",
  },
  "indent_guides": {
    "enabled": true,
  },
  "show_whitespaces": "selection",
  "scrollbar": {
    "show": "system",
  },
  "feature_flags": {
    "notebooks": "on",
    "tabular-data-preview": "on"
  }
}
